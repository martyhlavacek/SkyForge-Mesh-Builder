{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skyforge.multiview-authority-bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetId", "profileId", "createdAt", "sourceCommit", "viewOrder", "cameraDeclaration", "crossViewConsistency", "views", "contactSheet", "approval", "bundleDigest"],
  "properties": {
    "schemaVersion": {"const": "skyforge.multiview-authority-bundle.v1"},
    "assetId": {"type": "string", "minLength": 1},
    "profileId": {"enum": ["enemy_gunship", "enemy_interceptor"]},
    "createdAt": {"type": "string", "minLength": 1},
    "sourceCommit": {"type": "string", "minLength": 1},
    "viewOrder": {"const": ["top", "front", "right"]},
    "cameraDeclaration": {"const": "measured_orthographic_cross_view_consistency_pass"},
    "crossViewConsistency": {
      "type": "object",
      "required": ["schemaVersion", "method", "aspectTolerancePpm", "centerTolerancePpm", "measuredAspectMismatchPpm", "minAspectMismatchPpm", "maxAspectMismatchPpm", "perViewBoundingBoxes", "perViewCenterOffsetsPpm", "thresholdsUsed", "thresholdSamples", "stabilityRule", "result"],
      "properties": {
        "schemaVersion": {"const": "skyforge.cross-view-consistency.v1"},
        "method": {"const": "deterministic_alpha_or_border_luminance_threshold_ensemble"},
        "aspectTolerancePpm": {"const": 150000},
        "centerTolerancePpm": {"const": 50000},
        "measuredAspectMismatchPpm": {"type": "integer", "minimum": 0},
        "minAspectMismatchPpm": {"type": "integer", "minimum": 0},
        "maxAspectMismatchPpm": {"type": "integer", "minimum": 0},
        "perViewBoundingBoxes": {"type": "object"},
        "perViewCenterOffsetsPpm": {"type": "object"},
        "thresholdsUsed": {"const": [8, 16, 24, 40, 60, 80]},
        "thresholdSamples": {"type": "array", "minItems": 6, "maxItems": 6},
        "stabilityRule": {"type": "object"},
        "result": {"const": "PASS"}
      }
    },
    "views": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/topView"},
        {"$ref": "#/$defs/frontView"},
        {"$ref": "#/$defs/rightView"}
      ],
      "items": false
    },
    "contactSheet": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "approval": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "approvedAt", "workflowId", "bundleDigest"],
          "properties": {
            "status": {"const": "APPROVED"},
            "approvedAt": {"type": "string", "minLength": 1},
            "workflowId": {"type": "string", "minLength": 1},
            "bundleDigest": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "bundleDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "dimensions", "mode", "hasAlpha", "backgroundStatus"],
      "properties": {
        "role": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "dimensions": {
          "type": "array",
          "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
          "items": false
        },
        "mode": {"type": "string", "minLength": 1},
        "hasAlpha": {"type": "boolean"},
        "backgroundStatus": {"const": "alpha_or_neutral_declared"}
      }
    },
    "topView": {"allOf": [{"$ref": "#/$defs/view"}, {"properties": {"role": {"const": "top"}}}]},
    "frontView": {"allOf": [{"$ref": "#/$defs/view"}, {"properties": {"role": {"const": "front"}}}]},
    "rightView": {"allOf": [{"$ref": "#/$defs/view"}, {"properties": {"role": {"const": "right"}}}]}
  }
}
