{
  "$id": "https://skyforge.local/contracts/vmp/v1/provider_capabilities.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approvalIdentityModel": {
      "enum": [
        "deterministic_reproducibility",
        "approved_artifact_immutability"
      ],
      "minLength": 1,
      "type": "string"
    },
    "authorityInputPreservation": {
      "additionalProperties": false,
      "properties": {
        "claimAllowed": {
          "type": "boolean"
        },
        "controlField": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "verified_controlled",
            "unverifiable",
            "not_applicable"
          ],
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "status",
        "controlField",
        "claimAllowed"
      ],
      "type": "object"
    },
    "captureRequiredBeforeReview": {
      "const": true,
      "type": "boolean"
    },
    "costUnit": {
      "enum": [
        "credits",
        "usd",
        "none"
      ],
      "minLength": 1,
      "type": "string"
    },
    "geometryDeterminism": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "deterministic",
            "nondeterministic",
            "unknown"
          ],
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "modelAvailabilityRisk": {
      "minLength": 1,
      "type": "string"
    },
    "modelId": {
      "minLength": 1,
      "type": "string"
    },
    "operations": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "providerId": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": "skyforge.mesh-provider-capabilities.v1",
      "minLength": 1,
      "type": "string"
    },
    "sourceUrls": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "verifiedAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "providerId",
    "modelId",
    "operations",
    "authorityInputPreservation",
    "geometryDeterminism",
    "costUnit",
    "captureRequiredBeforeReview",
    "approvalIdentityModel",
    "verifiedAt",
    "sourceUrls",
    "modelAvailabilityRisk"
  ],
  "title": "Provider capability and authority-input preservation claims",
  "type": "object"
}
