{
  "$id": "https://skyforge.local/contracts/vmp/v1/structural_measurements.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "measurements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "unit": {
            "minLength": 1,
            "type": "string"
          },
          "value": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "name",
          "value"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": "skyforge.structural-measurements.v1",
      "minLength": 1,
      "type": "string"
    },
    "sourceGlbSha256": {
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "topologyLimitations": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "sourceGlbSha256",
    "measurements",
    "topologyLimitations"
  ],
  "title": "Optional factual structural measurements without eligibility decisions",
  "type": "object"
}
